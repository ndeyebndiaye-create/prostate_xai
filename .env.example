# Copy this file to .env and fill in the real path. Never commit .env itself
# (it's already in .gitignore) — paths differ per machine, and this keeps
# collaborators (or future-you on a new laptop) from having to edit source code.

# Root of the Google Drive Desktop synced folder that contains picai/, tcia/, etc.
# This is a NORMAL LOCAL PATH from the code's perspective — Drive Desktop
# handles the sync transparently, src/ never knows Drive is involved.
DATA_ROOT=/path/to/your/synced/GoogleDrive/thesis_data

# Only needed once Step 8 (storage layer) is actually run — leave as-is for now.
QDRANT_HOST=localhost
QDRANT_PORT=6333
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=prostate_xai
POSTGRES_USER=prostate_xai
POSTGRES_PASSWORD=changeme
