# Secrets / machine-specific config — never commit
.env

# Never commit data
*.mha
*.dcm
*.nii
*.nii.gz
!requirements.txt

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/

# Checkpoints (potentiellement plusieurs centaines de MB — ne pas versionner)
# Pour partager un checkpoint précis, uploader manuellement sur Drive et noter
# le lien dans CHANGELOG.md.
checkpoints/
checkpoints
*.pt
*.pth

# Outputs locaux et données volumineuses
logs/
logs
data/
picai/
*.h5
*.hdf5
*.zip
*.tar
*.tar.gz

# Docker volumes are managed by Docker itself, not git
