# Secrets / machine-specific config — never commit
.env
rclone.conf

# Never commit data
*.mha
*.npy
*.dcm
*.nii
*.nii.gz
!requirements.txt

# Python & virtual environments
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
mon_env/
venv/
env/

# Checkpoints (potentiellement plusieurs centaines de MB — ne pas versionner)
# Pour partager un checkpoint précis, uploader manuellement sur Drive et noter
# le lien dans CHANGELOG.md.
checkpoints/
checkpoints
*.pt
*.pth

# Outputs locaux et données volumineuses (les logs/*.csv légers sont versionnés)
/data/
picai/
*.h5
*.hdf5
*.zip
*.tar
*.tar.gz

# Docker volumes are managed by Docker itself, not git
